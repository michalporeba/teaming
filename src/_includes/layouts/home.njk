---
layout: layouts/base.njk
---
<main class="col home">
  <h1>{{ site.title }}</h1>
  <p class="intro">{{ site.description }}</p>

  <ol class="workshops">
    {%- for w in collections.workshops %}
    <li><a href="{{ w.url }}">{{ w.data.title }}</a><span>{{ w.data.length }}</span></li>
    {%- endfor %}
  </ol>

  {%- if collections.additionalWorkshops.length %}
  <p class="also">Also:
    {%- for w in collections.additionalWorkshops %} <a href="{{ w.url }}">{{ w.data.title }}</a>{% if not loop.last %},{% endif %}{% endfor %}
  </p>
  {%- endif %}

  <footer>
    <nav>
      {%- for item in site.nav %}<a href="{{ item.url }}">{{ item.label }}</a>{% endfor -%}
      <a href="{{ site.repo }}">GitHub</a>
    </nav>
    {{ content | safe }}
  </footer>
</main>
